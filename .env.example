# Copy to .env.local (web) or export in your shell (worker). Never commit real values.

# Public: safe for the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Server/worker only: never expose to the client. In CI use GitHub Secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Bot username without @ (e.g. LiveShowRadarBot); used to build the t.me link.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
